FROM        registry.gitlab.steamos.cloud/steamrt/steamrt4/sdk:latest-container-runtime-depot
LABEL       author="Source2ZE"
LABEL       org.opencontainers.image.description="Docker container used as a build environment for our plugins"
LABEL       org.opencontainers.image.source="https://github.com/Source2ZE/build-containers"

ENV         DEBIAN_FRONTEND=noninteractive

# Install Clang 22
RUN         echo "deb http://apt.llvm.org/trixie/ llvm-toolchain-trixie-22 main" >> /etc/apt/sources.list.d/llvm.list
RUN         echo "deb-src http://apt.llvm.org/trixie/ llvm-toolchain-trixie-22 main" >> /etc/apt/sources.list.d/llvm.list
RUN         wget -O - https://apt.llvm.org/llvm-snapshot.gpg.key | sudo apt-key add -
RUN         apt update && apt install -y clang-22 && apt clean
RUN         ln -sf /usr/bin/clang-22 /usr/bin/clang && ln -sf /usr/bin/clang++-22 /usr/bin/clang++

# Install AMBuild
RUN         git clone https://github.com/alliedmodders/ambuild
RUN         cd ambuild && python setup.py install